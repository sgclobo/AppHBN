{
  "expo": {
    "name": "Harohan ba Nai",
    "slug": "harohan-ba-nai",
    "version": "1.0.0",
    "output": "static",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apphbn",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF9FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "Harohan ba Nai",
      "shortName": "Harohan",
      "favicon": "./assets/images/favicon.png",
      "manifest": {
        "name": "Harohan ba Nai",
        "short_name": "Harohan",
        "description": "Kântikus no Orasoens Katólika",
        "start_url": "/",
        "theme_color": "#c1121f",
        "background_color": "#FDF9FF",
        "display": "standalone",
        "orientation": "portrait",
        "icons": [
          {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
          },
          {
            "src": "/icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Harohan ba Nai to save images to your gallery.",
          "savePhotosPermission": "Allow Harohan ba Nai to save images to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDF9FF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
